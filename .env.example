# Environment
DEBUG=false

# Database (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./kalendav.db

# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kalendav

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Default Admin Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Server
HOST=0.0.0.0
PORT=8000

# Base URI (used for CalDAV/ICS links in UI and sync tokens)
# Set this to your public-facing URL in production
BASE_URI=http://localhost:8000

# Default IANA timezone for ICS feed serialization (e.g. Australia/Brisbane).
# Applied to events stored without explicit timezone info. Defaults to UTC.
DEFAULT_TIMEZONE=UTC
